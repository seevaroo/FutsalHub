flowchart LR
    %% ==========================================
    %% BAGIAN 1: AKSES AWAL & AUTENTIKASI PENGGUNA
    %% ==========================================
    Start(["Mulai / Buka Web FutsalHub"]) --> DecisionPunyaAkun{"Sudah Punya<br/>Akun?"}

    %% Jalur Pengguna Baru (Belum Punya Akun)
    DecisionPunyaAkun -- "Belum (Baru)" --> PageRegister["Form Registrasi (/register)<br/>Input Nama, Email, Sandi & No WA (+62)"]
    PageRegister --> SubmitRegister["Klik 'Daftar Akun'"]
    SubmitRegister --> RedirectLogin["Auto-Redirect ke Login (/login)<br/>Toast: 'Akun berhasil dibuat!'"]
    RedirectLogin --> InputLoginBaru["Input Email & Password"]

    %% Jalur Pengguna Lama (Sudah Punya Akun)
    DecisionPunyaAkun -- "Sudah (Lama)" --> PageLoginDirect["Buka Halaman Login (/login)"]
    PageLoginDirect --> InputLoginLama["Input Email & Password"]

    %% Proses Autentikasi
    InputLoginBaru --> SubmitAuth["Klik Tombol 'Masuk'"]
    InputLoginLama --> SubmitAuth

    %% Validasi Status Akun & Kredensial
    SubmitAuth --> CheckStatus{"Status Akun &<br/>Kredensial?"}

    CheckStatus -- "Dihapus User" --> BlockUser["Akses Ditolak:<br/>'Dihapus pengguna &<br/>tidak dapat dipulihkan'"]
    CheckStatus -- "Dihapus Admin" --> BlockAdmin["Akses Ditolak:<br/>'Dinonaktifkan oleh<br/>administrator'"]

    %% Akun Aktif & Valid
    CheckStatus -- "Aktif & Valid" --> CheckRole{"Peran Akun<br/>(Role)?"}

    %% ==========================================
    %% BAGIAN 2: CABANG ROLE (ADMIN VS CUSTOMER)
    %% ==========================================
    CheckRole -- "Admin" --> AdminDashboard["Admin Dashboard (/admin/dashboard)<br/>• Kelola Lapangan & Tarif<br/>• Manajemen Customer WA (+62)<br/>• Verifikasi QRIS & Cash"]

    CheckRole -- "Customer" --> CheckNewUser{"Status Registrasi?"}

    CheckNewUser -- "Akun Baru" --> HomeNew["Beranda Customer (/)<br/>Toast: 'Selamat datang di FutsalHub!'"]
    CheckNewUser -- "Akun Lama" --> HomeOld["Beranda Customer (/)<br/>Toast: 'Selamat datang kembali!'"]

    %% ==========================================
    %% BAGIAN 3: ALUR PEMESANAN LAPANGAN (CUSTOMER)
    %% ==========================================
    HomeNew --> BrowseFields["Pilih / Katalog Lapangan (/fields)<br/>• Filter: Vinyl / Sintetis / Interlock"]
    HomeOld --> BrowseFields

    BrowseFields --> SelectSlot["Pilih Tanggal & Jam Main (Slot Engine)<br/>• Cek Ketersediaan Real-Time"]

    SelectSlot --> Checkout["Halaman Checkout Pesanan<br/>• Rincian Biaya & Kontak (+62)"]

    Checkout --> DecisionMethod{"Pilih Metode<br/>Bayar?"}

    %% ==========================================
    %% BAGIAN 4: PEMBAYARAN MULTI-KANAL (QRIS & CASH)
    %% ==========================================
    %% Jalur QRIS
    DecisionMethod -- "QRIS Digital" --> PayQRIS["Scan QRIS & Transfer<br/>Upload Bukti Bayar"]
    PayQRIS --> PendingQRIS["Status: PENDING<br/>Menunggu Verifikasi Bukti"]

    %% Jalur Cash
    DecisionMethod -- "Cash di Kasir" --> PayCash["Pilih Bayar Tunai<br/>Datang ke Kasir Saat Main"]
    PayCash --> PendingCash["Status: PENDING<br/>Menunggu Bayar di Kasir"]

    %% ==========================================
    %% BAGIAN 5: VERIFIKASI ADMIN
    %% ==========================================
    PendingQRIS --> AdminVerification["Admin: Verifikasi Pembayaran (/admin/payments)"]
    PendingCash --> AdminVerification
    AdminDashboard -. "Buka Panel" .-> AdminVerification

    AdminVerification --> DecisionAdminAction{"Tindakan<br/>Admin Kasir?"}

    %% Setujui / Konfirmasi Cash
    DecisionAdminAction -- "Setujui / Konfirmasi" --> ApproveAction["Admin Validasi Lunas"]
    ApproveAction --> BookingConfirmed["Status: CONFIRMED<br/>• Invoice Resmi Terbit<br/>• Kode Booking Aktif"]

    %% Tolak / Batalkan Cash
    DecisionAdminAction -- "Tolak / Batalkan" --> RejectAction["Admin Tolak Bukti / Batalkan"]
    RejectAction --> BookingCancelled["Status: CANCELLED<br/>• Jam Otomatis Dilepas<br/>• Terbuka untuk Orang Lain"]

    %% Batal Mandiri oleh Customer (Sebelum Diverifikasi)
    PendingQRIS -. "Batal Mandiri" .-> BookingCancelled
    PendingCash -. "Batal Mandiri" .-> BookingCancelled

    %% ==========================================
    %% BAGIAN 6: TITIK TERMINAL AKHIR (SELESAI)
    %% ==========================================
    BookingConfirmed --> End(["Selesai"])
    BookingCancelled --> End
    BlockUser --> End
    BlockAdmin --> End

    %% ==========================================
    %% STYLING / WARNA NODE
    %% ==========================================
    classDef startNode fill:#10b981,stroke:#047857,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef decisionNode fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e,font-weight:bold;
    classDef processNode fill:#ffffff,stroke:#475569,stroke-width:1.5px,color:#0f172a;
    classDef customerNode fill:#f8fafc,stroke:#0284c7,stroke-width:1.5px,color:#0369a1;
    classDef adminNode fill:#0f172a,stroke:#38bdf8,stroke-width:2px,color:#ffffff,font-weight:bold;
    classDef successNode fill:#ecfdf5,stroke:#10b981,stroke-width:2px,color:#065f46,font-weight:bold;
    classDef dangerNode fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#9f1239,font-weight:bold;

    class Start,End startNode;
    class DecisionPunyaAkun,CheckStatus,CheckRole,CheckNewUser,DecisionMethod,DecisionAdminAction decisionNode;
    class PageRegister,SubmitRegister,RedirectLogin,InputLoginBaru,PageLoginDirect,InputLoginLama,SubmitAuth,PayQRIS,PayCash,PendingQRIS,PendingCash processNode;
    class BrowseFields,SelectSlot,Checkout customerNode;
    class HomeNew,HomeOld,ApproveAction,BookingConfirmed successNode;
    class BlockUser,BlockAdmin,RejectAction,BookingCancelled dangerNode;
    class AdminDashboard,AdminVerification adminNode;
